{
  "info": { "name": "Projeto Acadêmico - Professor, Curso e Aluno", "description": "Fluxo: professor -> curso -> aluno. Os IDs retornados são guardados automaticamente para as consultas por ID.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [ { "key": "baseUrl", "value": "http://localhost:8081" }, { "key": "professorId", "value": "" }, { "key": "cursoId", "value": "" }, { "key": "alunoId", "value": "" } ],
  "item": [
    { "name": "1 - Cadastrar professor (POST)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Ana Lima\",\n  \"email\": \"ana@faculdade.edu\",\n  \"departamento\": \"Computação\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/professores" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(201);", "pm.collectionVariables.set('professorId', pm.response.json().id);"] } }] },
    { "name": "2 - Cadastrar curso (POST)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Spring Boot\",\n  \"professorId\": {{professorId}}\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/cursos" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(201);", "pm.collectionVariables.set('cursoId', pm.response.json().id);"] } }] },
    { "name": "3 - Cadastrar aluno (POST)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"João Silva\",\n  \"email\": \"joao@aluno.edu\",\n  \"cursoId\": {{cursoId}}\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/alunos" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(201);", "pm.collectionVariables.set('alunoId', pm.response.json().id);"] } }] },
    { "name": "4 - Consultar professores (GET)", "request": { "method": "GET", "url": "{{baseUrl}}/professores" } },
    { "name": "5 - Consultar professor por ID (GET)", "request": { "method": "GET", "url": "{{baseUrl}}/professores/{{professorId}}" } },
    { "name": "6 - Consultar cursos (GET)", "request": { "method": "GET", "url": "{{baseUrl}}/cursos" } },
    { "name": "7 - Consultar curso por ID (GET)", "request": { "method": "GET", "url": "{{baseUrl}}/cursos/{{cursoId}}" } },
    { "name": "8 - Consultar alunos (GET)", "request": { "method": "GET", "url": "{{baseUrl}}/alunos" } },
    { "name": "9 - Consultar aluno por ID (GET)", "request": { "method": "GET", "url": "{{baseUrl}}/alunos/{{alunoId}}" } }
  ]
}
