{
  "info": {
    "name": "TesteCadastroAluno",
    "description": "Parte 2: execute primeiro Obter token. A senha e exibida no terminal ao iniciar a aplicacao.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8081" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Obter token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "password", "type": "text" },
            { "key": "username", "value": "user", "type": "text" },
            { "key": "password", "value": "COLE_A_SENHA_DO_TERMINAL_AQUI", "type": "text" }
          ]
        },
        "url": "{{baseUrl}}/oauth/token"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Token retorna 200\", function () { pm.response.to.have.status(200); });", "pm.collectionVariables.set(\"accessToken\", pm.response.json().access_token);"] } }]
    },
    {
      "name": "Cadastrar Pedro",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Pedro\",\n  \"cpf\": \"12388811166\",\n  \"ra\": \"12312\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/aluno"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Cadastro retorna 201\", function () { pm.response.to.have.status(201); });"] } }]
    },
    {
      "name": "Cadastrar Joao",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Joao\",\n  \"cpf\": \"33388811166\",\n  \"ra\": \"33312\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/aluno"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Cadastro retorna 201\", function () { pm.response.to.have.status(201); });"] } }]
    },
    {
      "name": "Cadastrar Maria",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Maria\",\n  \"cpf\": \"55388811166\",\n  \"ra\": \"23312\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/aluno"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Cadastro retorna 201\", function () { pm.response.to.have.status(201); });"] } }]
    },
    {
      "name": "Consultar alunos",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/aluno"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Consulta retorna 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"Resposta e uma lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"] } }]
    }
  ]
}
